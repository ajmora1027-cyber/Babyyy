<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Be My Valentine? 💜</title>
  <style>
    :root{
      --bg:#ead9ff;
      --card:rgba(255,255,255,.82);
      --ink:#241238;
      --yes:#5b2cff;
      --yesHover:#4a22d9;
      --no:#ff4d6d;
      --shadow: 0 18px 55px rgba(35, 8, 70, .18);
      --radius: 26px;
    }
    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      color: var(--ink);
      background: radial-gradient(1200px 700px at 20% 20%, #f6eeff 0%, var(--bg) 55%, #dcc5ff 100%);
      overflow:hidden;
    }
    .wrap{ height:100%; display:grid; place-items:center; padding:24px; position:relative; }
    .card{
      width:min(760px, 92vw);
      background:var(--card);
      border:1px solid rgba(255,255,255,.7);
      backdrop-filter: blur(10px);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
      padding: clamp(22px, 3.8vw, 40px);
      text-align:center;
      position:relative;
    }
    h1{ margin:0 0 10px; font-size: clamp(28px, 4.2vw, 46px); letter-spacing:-.02em; }
    p{ margin:0 0 26px; font-size: clamp(14px, 2.2vw, 18px); opacity:.88; }

    .btnArea{
      position:relative;
      height: 92px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:14px;
      padding:6px 0;
      touch-action:none;
    }
    button{
      border:0;
      padding:14px 22px;
      font-size:18px;
      border-radius:999px;
      cursor:pointer;
      box-shadow: 0 10px 24px rgba(30, 10, 70, .14);
      transition: transform .14s ease, background .14s ease;
      user-select:none;
      -webkit-tap-highlight-color: transparent;
    }
    button:active{ transform: translateY(1px) scale(.99); }

    #yesBtn{ background: var(--yes); color:#fff; }
    #yesBtn:hover{ background: var(--yesHover); transform: translateY(-1px); }

    #noBtn{
      background: var(--no);
      color:#fff;
      position:absolute;
      left:58%;
      top:20px;
    }

    .hearts{ position:absolute; inset:-40px; pointer-events:none; opacity:.25; }
    .heart{ position:absolute; font-size: clamp(16px, 2.2vw, 28px); animation: floaty linear infinite; filter: blur(.15px); }
    @keyframes floaty{ from{ transform: translateY(30px) rotate(0deg);} to{ transform: translateY(-120vh) rotate(360deg);} }

    #overlay{
      position:fixed; inset:0;
      display:none; place-items:center;
      background: rgba(20, 8, 40, .35);
      backdrop-filter: blur(6px);
      z-index:10;
      padding:18px;
    }
    .modal{
      width:min(860px, 92vw);
      background: rgba(255,255,255,.92);
      border-radius: 30px;
      box-shadow: var(--shadow);
      border: 1px solid rgba(255,255,255,.75);
      padding: clamp(18px, 3vw, 32px);
      text-align:center;
      position:relative;
      overflow:hidden;
    }
    .modal h2{ margin:0 0 10px; font-size: clamp(26px, 3.8vw, 42px); }
    .modal .sub{ margin:0 0 16px; font-size: clamp(14px, 2.2vw, 18px); opacity:.85; }

    .stickerWrap{ display:grid; place-items:center; margin:14px 0 10px; }
    .sticker{
      width:min(320px, 70vw);
      aspect-ratio: 1 / 1;
      border-radius: 34px;
      background: radial-gradient(180px 180px at 30% 25%, #fff 0%, #f5ecff 50%, #e2d2ff 100%);
      border: 1px solid rgba(125, 86, 255, .25);
      box-shadow: 0 18px 40px rgba(30, 10, 70, .18);
      display:grid;
      place-items:center;
      position:relative;
    }
    .sticker img{ width:100%; height:100%; object-fit:contain; border-radius:34px; display:none; }

    .fallback{ padding:22px; line-height:1.05; }
    .fallback .dudu{ font-size:54px; font-weight:800; letter-spacing:-.02em; }
    .fallback .caption{ margin-top:10px; font-size:18px; opacity:.85; }

    .sparkles{ position:absolute; inset:0; pointer-events:none; }
    .sparkles span{ position:absolute; font-size:20px; animation: pop 1.1s ease-in-out infinite; opacity:.9; }
    @keyframes pop{ 0%,100%{ transform:scale(.9) rotate(0deg); opacity:.65; } 50%{ transform:scale(1.18) rotate(10deg); opacity:1; } }

    .closeBtn{ margin-top:14px; background:#2a1b3d; color:#fff; }
    .closeBtn:hover{ transform: translateY(-1px); }

    #confetti{ position:fixed; inset:0; pointer-events:none; z-index:20; display:none; }
    .tinyNote{ margin-top:14px; font-size:12px; opacity:.65; }
  </style>
</head>
<body>
  <canvas id="confetti"></canvas>

  <div class="wrap">
    <div class="hearts" id="hearts"></div>

    <div class="card">
      <h1>Will you be my Valentine? 💜</h1>
      <p>I have a very important question… and only one correct answer 😌</p>

      <div class="btnArea" id="btnArea">
        <button id="yesBtn">Yes 💖</button>
        <button id="noBtn">No 🙃</button>
      </div>

      <div class="tinyNote">(P.S. the “No” button is feeling shy today.)</div>
    </div>
  </div>

  <div id="overlay" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal">
      <h2>YAYYYYY!! 🎉💜</h2>
      <div class="sub">You just made someone extremely happy.</div>

      <div class="stickerWrap">
        <div class="sticker">
          <img id="stickerImg" alt="Celebrating Dudu sticker" />
          <div class="fallback" id="fallback">
            <div class="dudu">DUDU</div>
            <div class="caption">celebrating!! 🥳✨</div>
          </div>
          <div class="sparkles" aria-hidden="true">
            <span style="top:10%; left:12%;">✨</span>
            <span style="top:18%; right:14%; animation-delay:.2s;">💫</span>
            <span style="bottom:14%; left:16%; animation-delay:.35s;">⭐</span>
            <span style="bottom:18%; right:12%; animation-delay:.15s;">✨</span>
          </div>
        </div>
      </div>

      <button class="closeBtn" id="closeBtn">Close</button>
    </div>
  </div>

  <script>
    // Paste your real “Celebrating Dudu” sticker image URL here (optional):
    const DUDU_STICKER_URL = "";

    // Hearts BG
    const heartsEl = document.getElementById("hearts");
    const heartChars = ["💜","💖","💟","💘","✨"];
    for (let i=0;i<26;i++){
      const h=document.createElement("div");
      h.className="heart";
      h.textContent=heartChars[Math.floor(Math.random()*heartChars.length)];
      h.style.left=(Math.random()*100)+"%";
      h.style.top=(60+Math.random()*60)+"%";
      h.style.animationDuration=(7+Math.random()*10)+"s";
      h.style.animationDelay=(-Math.random()*10)+"s";
      heartsEl.appendChild(h);
    }

    // Runaway NO
    const noBtn = document.getElementById("noBtn");
    const btnArea = document.getElementById("btnArea");
    const clamp=(v,min,max)=>Math.max(min,Math.min(max,v));

    function moveNoButton(awayX=null, awayY=null){
      const area = btnArea.getBoundingClientRect();
      const btn = noBtn.getBoundingClientRect();
      const pad=8;
      const maxX=area.width - btn.width - pad;
      const maxY=area.height - btn.height - pad;

      let x=Math.random()*maxX + pad;
      let y=Math.random()*maxY + pad;

      if (awayX!=null && awayY!=null){
        const cx = awayX - area.left;
        const cy = awayY - area.top;

        x = (cx < area.width/2) ? (area.width*0.65) : (area.width*0.10);
        y = (cy < area.height/2) ? (area.height*0.55) : (area.height*0.15);

        x += (Math.random()-0.5)*area.width*0.18;
        y += (Math.random()-0.5)*area.height*0.25;

        x = clamp(x, pad, maxX);
        y = clamp(y, pad, maxY);
      }

      noBtn.style.left = x + "px";
      noBtn.style.top  = y + "px";
    }
    window.addEventListener("load", () => moveNoButton());

    function maybeRunAway(clientX, clientY){
      const b = noBtn.getBoundingClientRect();
      const dx = clientX - (b.left + b.width/2);
      const dy = clientY - (b.top + b.height/2);
      const dist = Math.hypot(dx, dy);
      const radius = (window.innerWidth < 600) ? 120 : 90; // a bit bigger on mobile
      if (dist < radius) moveNoButton(clientX, clientY);
    }

    btnArea.addEventListener("pointermove", (e) => maybeRunAway(e.clientX, e.clientY));
    btnArea.addEventListener("pointerdown", (e) => maybeRunAway(e.clientX, e.clientY));
    ["mouseenter","focus","pointerenter"].forEach(evt =>
      noBtn.addEventListener(evt, (e) => moveNoButton(e.clientX ?? null, e.clientY ?? null))
    );

    // YES -> overlay + confetti
    const yesBtn = document.getElementById("yesBtn");
    const overlay = document.getElementById("overlay");
    const closeBtn = document.getElementById("closeBtn");
    const stickerImg = document.getElementById("stickerImg");
    const fallback = document.getElementById("fallback");

    if (DUDU_STICKER_URL){
      stickerImg.src = DUDU_STICKER_URL;
      stickerImg.style.display = "block";
      fallback.style.display = "none";
    }

    yesBtn.addEventListener("click", () => {
      overlay.style.display = "grid";
      overlay.setAttribute("aria-hidden","false");
      startConfetti(2200);
    });

    function closeOverlay(){
      overlay.style.display = "none";
      overlay.setAttribute("aria-hidden","true");
      stopConfetti();
    }
    closeBtn.addEventListener("click", closeOverlay);
    overlay.addEventListener("click", (e)=>{ if(e.target===overlay) closeOverlay(); });
    window.addEventListener("keydown", (e)=>{ if(e.key==="Escape" && overlay.style.display==="grid") closeOverlay(); });

    // Confetti
    const confettiCanvas = document.getElementById("confetti");
    const ctx = confettiCanvas.getContext("2d");
    let pieces=[], raf=null, timer=null;

    function resize(){
      confettiCanvas.width = window.innerWidth * devicePixelRatio;
      confettiCanvas.height = window.innerHeight * devicePixelRatio;
      ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
    }
    window.addEventListener("resize", resize);
    resize();

    const rand=(a,b)=>Math.random()*(b-a)+a;

    function makeConfetti(count=200){
      const w=window.innerWidth, h=window.innerHeight;
      const colors=["#5b2cff","#ff4d6d","#ffd166","#06d6a0","#4cc9f0","#9b5de5","#f15bb5","#ffffff"];
      pieces = Array.from({length:count}, ()=>({
        x: rand(0,w), y: rand(-h*0.2,-10),
        vx: rand(-2.2,2.2), vy: rand(2.6,6.4),
        size: rand(6,12),
        rot: rand(0,Math.PI*2), vr: rand(-0.25,0.25),
        color: colors[Math.floor(Math.random()*colors.length)],
        shape: Math.random()<0.22 ? "circle":"rect",
        opacity: rand(0.75,1)
      }));
    }

    function draw(){
      const w=window.innerWidth, h=window.innerHeight;
      ctx.clearRect(0,0,w,h);
      for(const p of pieces){
        p.x += p.vx; p.y += p.vy; p.rot += p.vr;
        if(p.x<-20) p.x=w+20;
        if(p.x>w+20) p.x=-20;
        if(p.y>h+20){ p.y=rand(-60,-10); p.x=rand(0,w); p.vy=rand(2.6,6.4); }

        ctx.save();
        ctx.globalAlpha=p.opacity;
        ctx.translate(p.x,p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle=p.color;
        if(p.shape==="circle"){
          ctx.beginPath();
          ctx.arc(0,0,p.size*0.42,0,Math.PI*2);
          ctx.fill();
        } else {
          ctx.fillRect(-p.size/2,-p.size/3,p.size,p.size*0.66);
        }
        ctx.restore();
      }
      raf = requestAnimationFrame(draw);
    }

    function startConfetti(ms=2200){
      confettiCanvas.style.display="block";
      makeConfetti(200);
      cancelAnimationFrame(raf);
      draw();
      clearTimeout(timer);
      timer=setTimeout(stopConfetti, ms);
    }
    function stopConfetti(){
      clearTimeout(timer);
      cancelAnimationFrame(raf);
      ctx.clearRect(0,0,window.innerWidth,window.innerHeight);
      confettiCanvas.style.display="none";
    }
  </script>
</body>
</html>
